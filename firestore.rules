rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regra para Usuários / Clientes / Perfis de Crediário
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Regra para Solicitações de Crediário Próprio
    match /creditRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Regra para Coleção de Clientes
    match /clients/{clientId} {
      allow read, write: if request.auth != null;
    }

    // Regra para Catálogo de Produtos
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra para Categorias de Produtos
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra para Pedidos da Loja
    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    // Regra para Configurações da Loja (CMS Layout, Banners, Contatos)
    match /storeConfig/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Regra Global de Fallback para Usuários Autenticados
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
