# ==============================================================================
# EVIDENCIA CALCADOS - TEMPLATE DE VARIAVEIS DE AMBIENTE (.env)
# ==============================================================================
# NUNCA insira chaves reais de producao neste arquivo.
# Copie este arquivo para .env e preencha suas credenciais reais.
# ==============================================================================

# --- INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI) ---
# Chave da API do Google Gemini (utilizada pelo backend para sintese de descricoes e analise)
# Obtenha sua chave gratuitamente em: https://aistudio.google.com/
GEMINI_API_KEY=
# GOOGLE_GENAI_API_KEY=

# --- FIREBASE CONFIGURATION (AUTHENTICATION & CLOUD FIRESTORE) ---
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIRESTORE_DATABASE_ID=

# --- MOBLINK ERP (INTEGRACAO DE CATALOGO, CLIENTES E ESTOQUE) ---
# URL base da API do ERP MobLink (ex: https://api.evidenciacalcados.com.br/api/v1/)
VITE_API_URL=
# Token estatico ou credenciais para renovacao automatica via login no backend Node.js
EVIDENCIA_API_TOKEN=
EVIDENCIA_API_USER=
EVIDENCIA_API_PASSWORD=
EVIDENCIA_API_LOJA=

# --- SUPABASE (STORAGE DE FOTOS EM ALTA RESOLUCAO & BACKUPS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=products

# --- MERCADO PAGO (GATEWAY DE PAGAMENTOS PIX E CARTAO) ---
VITE_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=

# --- MELHOR ENVIO (COTACAO DE FRETE E LOGISTICA) ---
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ENV=sandbox
