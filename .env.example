# ==========================================
# EVIDÊNCIA CALÇADOS - ENVIRONMENT TEMPLATE
# ==========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials.

# API Base URL (Vite Client & Services)
VITE_API_URL="https://api.evidenciacalcados.com.br/api/v1"

# Firebase Configuration (Vite Client)
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"

# Evidência Calçados API Credentials (Backend Node.js)
# Used to obtain a JWT via POST ${VITE_API_URL}/login
EVIDENCIA_API_USER="site"
EVIDENCIA_API_PASSWORD="your-api-password"
EVIDENCIA_API_LOJA="0"

# Application Settings
APP_URL="http://localhost:3000"
GEMINI_API_KEY="your-gemini-api-key"

# Cloudinary Integration (Optional Frontend Uploads)
VITE_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="your-cloudinary-upload-preset"
